# =============================================================
# VOICE — Sarvam Bulbul v3 (TTS) / Saaras v4 (STT)
# Required for reading a story aloud and for the AI to score a child's
# spoken reading. Get a key at https://dashboard.sarvam.ai
# =============================================================
SARVAM_API_KEY="MY_SARVAM_API_KEY"
# Optional: a Sarvam custom pronunciation dictionary id, if you have one.
SARVAM_PRONUNCIATION_DICT_ID=""

# =============================================================
# OCR — Docling + EasyOCR microservice (backend/ocr)
# Run separately (see CLAUDE.md for the CPU-only torch install step):
# pip install -r backend/ocr/requirements.txt, then
# uvicorn main:app --port 8001 from that folder. Needs ~1-2 GB RAM.
# On first run it downloads its layout/recognition models (a few hundred
# MB, one-time, needs internet).
# =============================================================
OCR_SERVICE_URL="http://127.0.0.1:8001"

# =============================================================
# GEMINI — cloud fallback for OCR and text generation (server/geminiAi.ts)
# Used when the local OCR service or Ollama is unreachable/crashes, or
# always if the *_PROVIDER variables below say "gemini". Key from
# https://aistudio.google.com/apikey. The free tier allows only ~20
# requests/day on gemini-3.5-flash (a 200-page book needs ~60); enable
# billing on the key's project for real use.
# =============================================================
GEMINI_API_KEY=""
# Comma-separated fallback chain; tried in order, skipping overloaded or
# over-quota models. Leave empty for the built-in default.
GEMINI_MODEL=""
GEMINI_OCR_MODEL=""
# auto (default) = local service first, Gemini on failure
# local = never use Gemini; gemini = skip the local service entirely
OCR_PROVIDER="auto"
AI_TEXT_PROVIDER="auto"
# Voice: auto (default) = Sarvam first, Gemini when Sarvam fails; sarvam; gemini
SPEECH_PROVIDER="auto"
GEMINI_STT_MODEL=""

# =============================================================
# OXFORD DICTIONARIES API — student Word Dictionary (server/dictionary.ts)
# app_id/app_key from https://developer.oxforddictionaries.com (paid).
# With them, words from published books and a child's hard words are shown
# only when they are Oxford headwords, with the Oxford definition. Without
# them, the dictionary shows only its built-in word list.
# =============================================================
OXFORD_APP_ID=""
OXFORD_APP_KEY=""
# Optional: the sandbox base URL while testing a trial key.
OXFORD_API_BASE=""
GEMINI_TTS_MODEL=""

# =============================================================
# TEXT GENERATION — local Ollama model
# Powers textbook chapter analysis, Read-Along story generation, and
# pronunciation feedback. Install Ollama (https://ollama.com), then run
# `ollama pull qwen2.5:3b` (or set OLLAMA_MODEL to whatever you pulled).
# =============================================================
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:3b"

# =============================================================
# FIREBASE — server-side (Admin SDK), used by server/firebaseRoutes.ts
# for auth verification, curriculum, lessons, and reading-session sync.
# Provide EITHER FIREBASE_SERVICE_ACCOUNT_JSON (the full service-account
# JSON as a single-line string) OR GOOGLE_APPLICATION_CREDENTIALS (a path
# to that JSON file). Never commit the actual service-account file.
# =============================================================
FIREBASE_PROJECT_ID="MY_FIREBASE_PROJECT_ID"
GOOGLE_APPLICATION_CREDENTIALS=""
FIREBASE_SERVICE_ACCOUNT_JSON=""

# =============================================================
# FIREBASE — client-side (Vite), used by src/services/firebase.ts for
# Firebase Auth in the browser. These are public-by-design client keys,
# not secrets, but still project-specific — copy them from your Firebase
# project settings.
# =============================================================
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# =============================================================
# SERVER
# =============================================================
PORT=3000

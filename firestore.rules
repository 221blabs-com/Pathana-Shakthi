rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pathana Shakthi currently uses the Express backend + Firebase Admin SDK
    // as the only Firestore data access path. This prevents clients from
    // bypassing backend authorization while the backend is being built.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
